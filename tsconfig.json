{
  "extends": "@module-foundry/configs/solidjs/typescript",
  "compilerOptions": {
    "outDir": "./dist",
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": [
    "orval.config.ts",
    "vite.config.ts",
    "vite/**/*.ts",
    "tsconfig.json",
    "src",
    "src/**/*.d.ts",
    "types/**/*.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
