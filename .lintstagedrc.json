{
  "**/*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": "biome check --write --error-on-warnings --no-errors-on-unmatched",
  "**/*.{json,jsonc,graphql,gql}": "biome check --write --error-on-warnings --no-errors-on-unmatched",
  "src/**/*.css": [
    "stylelint --fix --max-warnings=0",
    "biome check --write --error-on-warnings --no-errors-on-unmatched"
  ],
  "src/**/*.{scss,sass}": [
    "stylelint --fix --max-warnings=0",
    "prettier --write"
  ],
  "**/*.{md,yaml,yml,html}": "prettier --write"
}
