{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Dmitry Maximyuk",
    "email": "d_maksimyk@vk.com",
    "url": "https://github.com/dmaximyuk"
  },
  "keywords": [
    "solidjs",
    "template",
    "boilerplate",
    "fsd",
    "feature-sliced",
    "typescript",
    "javascript",
    "sass"
  ],
  "engines": {
    "node": ">=24.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "postinstall": "husky",
    "prepare": "husky",
    "dev": "vite --host",
    "preview": "vite preview",
    "prebuild": "pnpm run validate",
    "build": "vite build",
    "build:compress": "cross-env BUILD_COMPRESS=true pnpm run build",
    "build:analyzer": "cross-env BUILD_ANALYZE=true pnpm run build",
    "validate": "tsc --noEmit && pnpm run validate:prettier && pnpm run validate:eslint && pnpm run validate:stylelint && pnpm run validate:steiger",
    "validate:prettier": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"*.{json,md,yml,yaml}\"",
    "validate:eslint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0 --fix",
    "validate:stylelint": "stylelint --fix \"src/**/*.{css,sass,scss}\"",
    "validate:steiger": "steiger --fail-on-warnings=0 ./src",
    "validate:commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/compat": "^1.4.1",
    "@eslint/js": "^9.39.4",
    "@feature-sliced/steiger-plugin": "^0.5.8",
    "@types/node": "^24.13.2",
    "browserslist": "^4.28.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-unicorn": "^60.0.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "postcss-sass": "^0.5.0",
    "prettier": "^3.9.0",
    "sass": "^1.101.0",
    "sharp": "^0.34.5",
    "steiger": "^0.5.13",
    "stylelint": "^17.14.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.1",
    "terser": "^5.48.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-svgr": "^4.5.0",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.4",
    "ky": "^1.14.3",
    "solid-js": "^1.9.13",
    "valibot": "^1.4.1"
  }
}
