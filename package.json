{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Dmitry Maximyuk",
    "email": "d_maksimyk@vk.com",
    "url": "https://github.com/dmaximyuk"
  },
  "keywords": [
    "solidjs",
    "template",
    "boilerplate",
    "fsd",
    "feature-sliced",
    "typescript",
    "javascript",
    "sass"
  ],
  "engines": {
    "node": ">=24.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "prepare": "husky",
    "dev": "vite --host",
    "preview": "vite preview",
    "api:generate": "cross-env BIOME_CONFIG_PATH=./biome-generated.json kubb generate --config kubb.config.ts",
    "api:watch": "cross-env BIOME_CONFIG_PATH=./biome-generated.json kubb generate --config kubb.config.ts --watch",
    "prebuild": "pnpm run validate",
    "build": "vite build",
    "build:production": "cross-env BUILD_COMPRESS=true pnpm run build",
    "build:analyzer": "cross-env BUILD_ANALYZE=true pnpm run build",
    "validate": "pnpm run validate:types && pnpm run validate:biome && pnpm run validate:prettier && pnpm run validate:stylelint && pnpm run validate:steiger",
    "validate:types": "tsc --noEmit",
    "validate:biome": "biome ci --error-on-warnings .",
    "validate:prettier": "prettier --check . --ignore-unknown",
    "validate:stylelint": "stylelint \"src/**/*.{css,scss}\" --max-warnings=0",
    "validate:steiger": "steiger --fail-on-warnings=0 ./src",
    "fix": "pnpm run fix:stylelint && pnpm run fix:biome && pnpm run fix:prettier",
    "fix:biome": "biome check --write --error-on-warnings .",
    "fix:prettier": "prettier --write . --ignore-unknown",
    "fix:stylelint": "stylelint --fix \"src/**/*.{css,scss}\" --max-warnings=0",
    "validate:commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@feature-sliced/steiger-plugin": "0.7.0",
    "@kubb/plugin-client": "5.5.3",
    "@kubb/plugin-ts": "5.0.3",
    "@types/node": "^24.13.2",
    "browserslist": "^4.28.4",
    "cross-env": "^10.1.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "kubb": "5.5.1",
    "mini-css-class-name": "^0.16.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "sharp": "^0.34.5",
    "steiger": "0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.1",
    "terser": "^5.48.0",
    "typescript": "7.0.2",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-solid-svg": "^0.8.1",
    "zod": "^4.6.5"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.4",
    "solid-js": "^1.9.13",
    "valibot": "^1.4.1"
  }
}
