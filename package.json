{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "license": "MIT",
  "author": {
    "name": "Dmitry Maximyuk",
    "email": "d_maksimyk@vk.com",
    "url": "https://github.com/dmaximyuk"
  },
  "keywords": [
    "solidjs",
    "template",
    "boilerplate",
    "fsd",
    "feature-sliced",
    "typescript",
    "javascript",
    "sass"
  ],
  "engines": {
    "node": ">=24.18"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "postinstall": "husky",
    "prepare": "husky",
    "dev": "vite --host",
    "preview": "vite preview",
    "api:generate": "orval --config orval.config.ts --formatter prettier",
    "api:watch": "orval --config orval.config.ts --watch",
    "prebuild": "pnpm run validate",
    "build": "vite build",
    "build:compress": "cross-env BUILD_COMPRESS=true pnpm run build",
    "build:analyzer": "cross-env BUILD_ANALYZE=true pnpm run build",
    "validate": "tsc --noEmit && pnpm run validate:prettier && pnpm run validate:eslint && pnpm run validate:stylelint && pnpm run validate:steiger",
    "validate:prettier": "prettier --write .",
    "validate:eslint": "eslint . --max-warnings=0 --fix",
    "validate:stylelint": "stylelint --fix \"src/**/*.{css,scss}\"",
    "validate:steiger": "steiger --fail-on-warnings=0 ./src",
    "validate:commitlint": "commitlint --edit"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^9.39.5",
    "@feature-sliced/steiger-plugin": "^0.7.0",
    "@module-foundry/configs": "^0.0.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "^24.13.2",
    "browserslist": "^4.28.4",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-jsdoc": "^63.3.3",
    "eslint-plugin-perfectionist": "^5.10.1",
    "eslint-plugin-regexp": "^3.2.0",
    "eslint-plugin-solid": "^0.14.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lightningcss": "^1.32.0",
    "lint-staged": "^16.4.0",
    "orval": "^8.24.0",
    "prettier": "^3.9.6",
    "sass": "^1.101.0",
    "sharp": "^0.34.5",
    "steiger": "^0.6.0",
    "stylelint": "^17.14.1",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-order": "^8.1.1",
    "svgo": "^4.0.1",
    "terser": "^5.48.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.67.0",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^7.3.6",
    "vite-bundle-analyzer": "^1.3.8",
    "vite-plugin-compression2": "^2.5.3",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vite-plugin-minify": "^2.1.0",
    "vite-plugin-solid": "^2.11.12",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@solid-primitives/i18n": "^2.2.1",
    "@solidjs/router": "^0.15.4",
    "@tanstack/solid-query": "5.101.4",
    "solid-js": "^1.9.13",
    "valibot": "^1.4.1"
  }
}
